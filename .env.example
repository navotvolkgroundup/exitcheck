# Copy to .env (git-ignored) or ~/.exitcheck.env, then: exitcheck router
# Real environment variables always win over this file.

EXITCHECK_ROUTER=192.168.1.1
# Backend: sagemcom | upnp | openwrt | fritzbox | asuswrt | mikrotik | auto
# Omit to autodetect. `upnp` needs no credentials at all.
EXITCHECK_TYPE=auto
EXITCHECK_USER=admin
EXITCHECK_PASSWORD=
